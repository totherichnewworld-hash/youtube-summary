<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd schedule: runs the summarizer locally once a day at 09:00.
  Install:  scripts/install-local-schedule.sh
  Edit the two __REPO__ paths below if you don't use the installer.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.youtube-summary.local</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run_local.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- If the Mac was asleep at 09:00, run as soon as it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO__/local-run.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/local-run.log</string>
</dict>
</plist>
