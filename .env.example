# Copy to `.env` for local runs (`set -a; . ./.env; set +a`), or use these as the
# names of GitHub Actions Secrets/Variables. Pick ONE summary backend block.

# ============================================================================
# SUMMARY BACKEND  (LLM_PROVIDER = anthropic | openai)
# ============================================================================

# --- Default: Claude (Anthropic) -------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# SUMMARY_MODEL=claude-opus-4-8        # optional override

# --- Any OTHER LLM API (OpenAI-compatible) ---------------------------------
# Uncomment ONE of the recipes below and comment out the Anthropic block above.
# All of these speak the same OpenAI chat API; only base URL + model differ.

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# SUMMARY_MODEL=gpt-4o-mini
# (OPENAI_BASE_URL unset -> https://api.openai.com/v1)

# Google Gemini (OpenAI-compatible endpoint)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza...
# SUMMARY_MODEL=gemini-2.0-flash

# DeepSeek
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# SUMMARY_MODEL=deepseek-chat

# Mistral
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_API_KEY=...
# SUMMARY_MODEL=mistral-large-latest

# xAI Grok
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=xai-...
# SUMMARY_MODEL=grok-2-latest

# Groq (fast, free tier)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# SUMMARY_MODEL=llama-3.3-70b-versatile

# OpenRouter (one key, hundreds of models)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# SUMMARY_MODEL=anthropic/claude-3.5-sonnet

# Local — Ollama (no key needed). LOCAL MODELS WORK ONLY WHEN YOU RUN run.py
# YOURSELF; GitHub Actions runners cannot reach your localhost.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# SUMMARY_MODEL=llama3.1

# ============================================================================
# TRANSCRIPTION  (only needed if your subscriptions include PODCASTS)
# ============================================================================
TRANSCRIBER=deepgram
DEEPGRAM_API_KEY=...
# TRANSCRIBER=assemblyai
# ASSEMBLYAI_API_KEY=...

# ============================================================================
# EMAIL DELIVERY (SMTP). Omit to just print/save summaries instead.
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com
